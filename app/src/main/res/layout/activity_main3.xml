<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">



    <TextView
        android:id="@+id/textView_invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/textView_result"
        app:layout_constraintTop_toTopOf="@+id/textView_result"
        android:text="この文章は見えません"
        android:visibility="invisible"
        />
    <TextView
        android:id="@+id/textView_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView_invisible"
        android:text="結果がここに表示されます"/>

    <Button
        android:id="@+id/button_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textView_invisible"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="13dp"
        android:text="7"
        />
    <Button
        android:id="@+id/button_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textView_invisible"
        app:layout_constraintStart_toEndOf="@+id/button_7"
        android:layout_margin="13dp"
        android:text="8"
        />
    <Button
        android:id="@+id/button_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textView_invisible"
        app:layout_constraintStart_toEndOf="@+id/button_8"
        android:layout_margin="13dp"
        android:text="9"
        />
    <Button
        android:id="@+id/button_division"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/textView_invisible"
        app:layout_constraintStart_toEndOf="@+id/button_9"
        android:layout_margin="13dp"
        android:text="÷"
        />
    <Button
        android:id="@+id/button_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_7"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="13dp"
        android:text="4"
        />
    <Button
        android:id="@+id/button_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_7"
        app:layout_constraintStart_toEndOf="@+id/button_7"
        android:layout_margin="13dp"
        android:text="5"
        />
    <Button
        android:id="@+id/button_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_7"
        app:layout_constraintStart_toEndOf="@+id/button_8"
        android:layout_margin="13dp"
        android:text="6"
        />
    <Button
        android:id="@+id/button_multiplication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_7"
        app:layout_constraintStart_toEndOf="@+id/button_9"
        android:layout_margin="13dp"
        android:text="×"
        />
    <Button
        android:id="@+id/button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_4"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="13dp"
        android:text="1"
        />
    <Button
        android:id="@+id/button_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_4"
        app:layout_constraintStart_toEndOf="@+id/button_7"
        android:layout_margin="13dp"
        android:text="2"
        />
    <Button
        android:id="@+id/button_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_4"
        app:layout_constraintStart_toEndOf="@+id/button_8"
        android:layout_margin="13dp"
        android:text="3"
        />
    <Button
        android:id="@+id/button_subtraction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_4"
        app:layout_constraintStart_toEndOf="@+id/button_9"
        android:layout_margin="13dp"
        android:text="-"
        />
    <Button
        android:id="@+id/button_ac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_1"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="13dp"
        android:text="AC"
        />
    <Button
        android:id="@+id/button_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_1"
        app:layout_constraintStart_toEndOf="@+id/button_7"
        android:layout_margin="13dp"
        android:text="0"
        />
    <Button
        android:id="@+id/button_equals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_1"
        app:layout_constraintStart_toEndOf="@+id/button_8"
        android:layout_margin="13dp"
        android:text="="
        />
    <Button
        android:id="@+id/button_addition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/button_1"
        app:layout_constraintStart_toEndOf="@+id/button_9"
        android:layout_margin="13dp"
        android:text="+"
        />



</androidx.constraintlayout.widget.ConstraintLayout>